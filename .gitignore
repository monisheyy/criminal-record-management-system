# ── Secrets ─────────────────────────────────────────────────────────────────
# Real configuration never enters version control; .env.example is the template.
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# ── Frontend ────────────────────────────────────────────────────────────────
node_modules/
dist/
frontend/test-results/
frontend/playwright-report/

# ── Local data (databases, backups, generated model artifacts) ──────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backups/
backend/app/ml/saved_models/*
!backend/app/ml/saved_models/.gitkeep

# ── Agent / editor worktrees and caches ─────────────────────────────────────
.kilo/
.kilocode/
.vscode/
.idea/
*.swp

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Generated test, build and release output ────────────────────────────────
release/
frontend_build.log
frontend_build.exit
frontend_test_results.txt
evaluation_stdout.json
ml_evaluation_report.json

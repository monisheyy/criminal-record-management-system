# AI-CRMS configuration template.
# Copy to `.env` (never commit `.env`) and fill in real values.
# Every variable is validated at start-up; production refuses unsafe values.

# ── Environment ──────────────────────────────────────────────────────────────
# development | test | production
APP_ENV=development

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Also signs ML artifacts and audit entries: rotating it requires retraining /
# re-activating the model (see docs/OPERATIONS.md).
SECRET_KEY=change-me-generate-a-random-48-byte-value-here

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite is fine for local development. Use PostgreSQL for shared/production use:
#   DATABASE_URL=postgresql+psycopg://crms:password@db:5432/crms
DATABASE_URL=sqlite:///./acrms.db

# ── Web / sessions ───────────────────────────────────────────────────────────
# Explicit allowlist of browser origins (HTTPS only in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host names the API may be reached as (required in production).
TRUSTED_HOSTS=*
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Session cookie flags; COOKIE_SECURE must be true behind HTTPS (production).
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
ENABLE_API_DOCS=true

# ── Account protection ───────────────────────────────────────────────────────
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_AUTH_PER_MINUTE=20

# ── Demo data (development only; refused in production) ──────────────────────
SEED_DEMO_DATA=true

# ── Password recovery ────────────────────────────────────────────────────────
# dev = OTP printed to the server log (development only); smtp = real e-mail.
RECOVERY_PROVIDER=dev
# RECOVERY_SMTP_HOST=
# RECOVERY_SMTP_PORT=587
# RECOVERY_SMTP_USERNAME=
# RECOVERY_SMTP_PASSWORD=
# RECOVERY_SMTP_FROM=

# ── AI decision support ──────────────────────────────────────────────────────
AI_PREDICTIONS_ENABLED=true
# Synthetic/demo-trained models may only run outside production.
AI_ALLOW_SYNTHETIC_MODELS=true
# Release quality gate a model candidate must pass before activation.
MODEL_GATE_MIN_MACRO_F1=0.60
MODEL_GATE_MIN_BALANCED_ACCURACY=0.60
MODEL_GATE_MAX_ZERO_RECALL_CLASSES=0
MODEL_GATE_REQUIRE_BEATS_BASELINE=true
MODEL_GATE_MAX_ECE=0.15
MODEL_GATE_MIN_TEST_SAMPLES=100
# Optional: store model artifacts outside the source tree.
# AI_CRMS_MODEL_DIR=/var/lib/ai-crms/models

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false

# ── Frontend (Vite, read at build time) ──────────────────────────────────────
# VITE_API_URL=http://localhost:8000
